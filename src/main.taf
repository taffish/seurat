<taf-app:container:ghcr.io/taffish/seurat:5.6.0-r1$@[docker/podman: --platform linux/amd64 --init $(taf_seurat_emit() { taf_seurat_path="$(cd "$1" 2>/dev/null && pwd -P)"; taf_seurat_bad="$(printf '%s' "$taf_seurat_path" | tr -d 'A-Za-z0-9_./+-')"; if test -z "$taf_seurat_path" || test -n "$taf_seurat_bad"; then printf >&2 'taf-seurat: resource bind path must use letters, digits, _, ., /, + or -; choose a safe physical path\n'; printf -- '--taffish-seurat-invalid-resource'; return; fi; printf -- '--volume=%s:%s' "$taf_seurat_path" "$2"; }; if test -n "${TAFFISH_SEURAT_RESOURCE_INSTALL_ROOT:-}"; then taf_seurat_emit "$TAFFISH_SEURAT_RESOURCE_INSTALL_ROOT" /resource-install; exit 0; fi; if test "${TAFFISH_SEURAT_RESOURCE_AUTO_MOUNT:-1}" = 0; then exit 0; fi; taf_seurat_root="${TAFFISH_SEURAT_RESOURCE_PATH:-}"; if test -z "$taf_seurat_root"; then for taf_seurat_candidate in "${XDG_DATA_HOME:-${HOME:-}/.local/share}/taffish/resources/seurat/seurat-data-20261004" /usr/local/share/taffish/resources/seurat/seurat-data-20261004 /opt/taffish/resources/seurat/seurat-data-20261004; do if test -e "$taf_seurat_candidate" || test -L "$taf_seurat_candidate"; then taf_seurat_root="$taf_seurat_candidate"; break; fi; done; fi; if test -n "$taf_seurat_root"; then if test -f "$taf_seurat_root/current/manifest.json"; then taf_seurat_emit "$taf_seurat_root" /opt/taffish-resources/seurat:ro; else printf >&2 'taf-seurat: selected resource has no completed manifest; run seurat-resource install/verify or select a prepared root\n'; printf -- '--taffish-seurat-invalid-resource'; fi; fi)][docker: --user=$(id -u):$(id -g)][podman: --userns=keep-id --user=$(id -u):$(id -g)][apptainer: $(taf_seurat_emit() { taf_seurat_path="$(cd "$1" 2>/dev/null && pwd -P)"; taf_seurat_bad="$(printf '%s' "$taf_seurat_path" | tr -d 'A-Za-z0-9_./+-')"; if test -z "$taf_seurat_path" || test -n "$taf_seurat_bad"; then printf >&2 'taf-seurat: resource bind path must use letters, digits, _, ., /, + or -; choose a safe physical path\n'; printf -- '--taffish-seurat-invalid-resource'; return; fi; printf -- '--bind=%s:%s' "$taf_seurat_path" "$2"; }; if test -n "${TAFFISH_SEURAT_RESOURCE_INSTALL_ROOT:-}"; then taf_seurat_emit "$TAFFISH_SEURAT_RESOURCE_INSTALL_ROOT" /resource-install; exit 0; fi; if test "${TAFFISH_SEURAT_RESOURCE_AUTO_MOUNT:-1}" = 0; then exit 0; fi; taf_seurat_root="${TAFFISH_SEURAT_RESOURCE_PATH:-}"; if test -z "$taf_seurat_root"; then for taf_seurat_candidate in "${XDG_DATA_HOME:-${HOME:-}/.local/share}/taffish/resources/seurat/seurat-data-20261004" /usr/local/share/taffish/resources/seurat/seurat-data-20261004 /opt/taffish/resources/seurat/seurat-data-20261004; do if test -e "$taf_seurat_candidate" || test -L "$taf_seurat_candidate"; then taf_seurat_root="$taf_seurat_candidate"; break; fi; done; fi; if test -n "$taf_seurat_root"; then if test -f "$taf_seurat_root/current/manifest.json"; then taf_seurat_emit "$taf_seurat_root" /opt/taffish-resources/seurat:ro; else printf >&2 'taf-seurat: selected resource has no completed manifest; run seurat-resource install/verify or select a prepared root\n'; printf -- '--taffish-seurat-invalid-resource'; fi; fi)]>
Rscript ::*ARGV*::
